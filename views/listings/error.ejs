<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-5">
    <div class="col-md-6 mx-auto">
        <div class="card shadow-sm border-0 text-center p-4">
            <div class="card-body">
                <div class="display-1 text-danger mb-3 font-monospace font-weight-bold"><%= statusCode || 404 %></div>
                <h3 class="card-title mb-2"><%= message || 'Page Not Found' %></h3>
                <p class="text-muted mb-4">The page you are looking for doesn't exist or another error occurred.</p>
                <a href="/listings" class="btn btn-danger px-4 py-2" style="border-radius: 8px;">
                    <i class="fa-solid fa-house me-2"></i>Back to Explore Stays
                </a>
            </div>
        </div>
    </div>
</div>