<%
    pageTitle = "Reset password | UrbanStay";
    pageDescription = "Request a password reset link for your UrbanStay account.";
%>
<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/login.css">
<div class="signup-container">
    <div class="row justify-content-center w-100">
        <div class="col-md-8 col-lg-5">
            <div class="card signup-card">
                <div class="card-body p-5">
                    <h2 class="signup-heading">Reset your password</h2>
                    <p class="signup-subtext">Enter your account email and we will send you a secure reset link.</p>

                    <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
                        <div class="mb-4">
                            <label for="email" class="form-label">Email</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="form-control custom-input"
                                placeholder="Enter your account email"
                                autocomplete="email"
                                required>
                        </div>

                        <button class="btn btn-signup w-100">Send reset link</button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="small text-muted">Remembered it? <a href="/login" class="login-link">Back to login</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
