<%
  const requestPath = currentPath || "";
  const isExplorePage = requestPath.startsWith("/listings/explore");
  const isNewListingPage = requestPath.startsWith("/listings/new");
  const isListingsPage = !isExplorePage && requestPath.startsWith("/listings");
  const isWishlistPage = requestPath.startsWith("/wishlist");
  const isProfilePage = requestPath.startsWith("/profile");
  const isAdminPage = requestPath.startsWith("/admin");
  const isChatPage = requestPath.startsWith("/chat");
  const isNotificationsPage = requestPath.startsWith("/notifications");
  const isSignupPage = requestPath.startsWith("/signup") || requestPath.startsWith("/user/signup");
  const isLoginPage = requestPath.startsWith("/login") || requestPath.startsWith("/user/login");
%>

<nav class="navbar navbar-expand-md sticky-top" aria-label="Primary">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
      <span>UrbanStay</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-left-link">
        <a class="nav-link nav-main-link <%= isListingsPage ? 'nav-link-current' : '' %>" href="/listings" <%= isListingsPage ? 'aria-current="page"' : '' %>>Explore</a>
        <a class="nav-link nav-main-link <%= isExplorePage ? 'nav-link-current' : '' %>" href="/listings/explore" <%= isExplorePage ? 'aria-current="page"' : '' %>>Map</a>
      </div>

      <div class="navbar-search-wrap">
        <form class="navbar-airbnb-search" action="/listings" method="GET" role="search" aria-label="Search stays">
          <label class="sr-only" for="navbar-search-input">Search stays, cities, or destinations</label>
          <span id="navbar-search-hint" class="sr-only">Search by stay name, city, or destination and press Enter to browse results.</span>
          <span class="search-static">Anywhere</span>
          <span class="search-divider"></span>
          <span class="search-static">Any week</span>
          <span class="search-divider"></span>
          <input
            id="navbar-search-input"
            name="q"
            type="search"
            placeholder="Search stays, cities, and homes"
            autocomplete="off"
            enterkeyhint="search"
            aria-describedby="navbar-search-hint"
            value="<%= typeof searchQuery === 'string' ? searchQuery : '' %>">
          <button type="submit" class="search-btn" aria-label="Search">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </form>
      </div>

      <div class="navbar-right-link">
        <a class="nav-link nav-main-link <%= isNewListingPage ? 'nav-link-current' : '' %>" href="/listings/new" <%= isNewListingPage ? 'aria-current="page"' : '' %>>Airbnb your home</a>
      </div>

      <div class="navbar-nav navbar-auth-links">
        <% if(!currentUser) { %>
          <a class="nav-link <%= isSignupPage ? 'nav-link-current' : '' %>" href="/user/signup" <%= isSignupPage ? 'aria-current="page"' : '' %>><b>Sign Up</b></a>
          <a class="nav-link <%= isLoginPage ? 'nav-link-current' : '' %>" href="/user/login" <%= isLoginPage ? 'aria-current="page"' : '' %>><b>Login</b></a>
        <% } else { %>
          <a class="nav-link nav-badge-link <%= isChatPage ? 'nav-link-current' : '' %>" href="/chat" <%= isChatPage ? 'aria-current="page"' : '' %>><b>Chat</b><% if (unreadChatCount > 0) { %><span class="nav-count-badge"><%= unreadChatCount %></span><% } %></a>
          <a class="nav-link nav-badge-link <%= isNotificationsPage ? 'nav-link-current' : '' %>" href="/notifications" <%= isNotificationsPage ? 'aria-current="page"' : '' %>><b>Alerts</b><% if (unreadNotificationCount > 0) { %><span class="nav-count-badge"><%= unreadNotificationCount %></span><% } %></a>
          <a class="nav-link <%= isWishlistPage ? 'nav-link-current' : '' %>" href="/wishlist" <%= isWishlistPage ? 'aria-current="page"' : '' %>><b>Wishlist</b></a>
          <% if (currentUser.isAdmin) { %>
            <a class="nav-link <%= isAdminPage ? 'nav-link-current' : '' %>" href="/admin" <%= isAdminPage ? 'aria-current="page"' : '' %>><b>Admin</b></a>
          <% } %>
          <a class="nav-link user-initial-link <%= isProfilePage ? 'nav-link-current' : '' %>" href="/profile" aria-label="Profile" <%= isProfilePage ? 'aria-current="page"' : '' %>>
            <span class="user-initial-badge"><%= (currentUser.username && currentUser.username.charAt(0).toUpperCase()) || "U" %></span>
            <span class="sr-only">Profile</span>
          </a>
          <a class="nav-link" href="/user/logout">Logout</a> 
        <% } %>
      </div>
    </div>
  </div>
</nav>
